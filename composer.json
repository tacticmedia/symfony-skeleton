{
    "name": "tacticmedia/symfony-skeleton",
    "description": "A Symfony Application starter kit.",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": "^8.5.0",
        "ext-apcu": "*",
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-iconv": "*",
        "ext-xsl": "*",
        "damienharper/auditor": "^4.3.1",
        "damienharper/auditor-bundle": "^7.2.0",
        "doctrine/dbal": "^4.5.0",
        "doctrine/doctrine-bundle": "^3.3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0.1",
        "doctrine/migrations": "^3.9.8",
        "doctrine/orm": "^3.7.4",
        "doctrine/persistence": "^4.2.1",
        "knplabs/knp-time-bundle": "^2.5",
        "league/commonmark": "^2.10.4",
        "martin-georgiev/postgresql-for-doctrine": "^4.9.0",
        "nelmio/security-bundle": "^3.9.0",
        "sentry/sentry": "^4.33.2",
        "sentry/sentry-symfony": "^5.13",
        "symfony/asset": "^8.1.0",
        "symfony/asset-mapper": "^8.1.9",
        "symfony/clock": "^8.1.9",
        "symfony/console": "^8.1.9",
        "symfony/dependency-injection": "^8.1.9",
        "symfony/doctrine-bridge": "^8.1.0",
        "symfony/doctrine-messenger": "^8.1.9",
        "symfony/dotenv": "^8.1.0",
        "symfony/event-dispatcher": "^8.1.0",
        "symfony/flex": "^2.11.0",
        "symfony/form": "^8.1.0",
        "symfony/framework-bundle": "^8.1.9",
        "symfony/http-foundation": "^8.1.9",
        "symfony/http-kernel": "^8.1.9",
        "symfony/lock": "^8.1.0",
        "symfony/mailer": "^8.1.0",
        "symfony/mercure": "^0.8.0",
        "symfony/mercure-bundle": "^0.5.0",
        "symfony/messenger": "^8.1.9",
        "symfony/mime": "^8.1.0",
        "symfony/options-resolver": "^8.1.0",
        "symfony/rate-limiter": "^8.1.0",
        "symfony/routing": "^8.1.9",
        "symfony/runtime": "^8.1.9",
        "symfony/security-bundle": "^8.1.9",
        "symfony/security-core": "^8.1.0",
        "symfony/security-http": "^8.1.9",
        "symfony/stimulus-bundle": "^3.6",
        "symfony/translation": "^8.1.0",
        "symfony/translation-contracts": "^3.7",
        "symfony/twig-bridge": "^8.1.0",
        "symfony/twig-bundle": "^8.1.0",
        "symfony/uid": "^8.1.0",
        "symfony/ux-icons": "^3.6",
        "symfony/ux-turbo": "^3.6.0",
        "symfony/ux-twig-component": "^3.6",
        "symfony/validator": "^8.1.0",
        "symfony/yaml": "^8.1.9",
        "symfonycasts/tailwind-bundle": "^1.0.0",
        "tacticmedia/rds-auth-bundle": "^1.2.0",
        "twig/cssinliner-extra": "^3.26",
        "twig/extra-bundle": "^3.29.0",
        "twig/html-extra": "^3.29.0",
        "twig/inky-extra": "^3.26",
        "twig/intl-extra": "^3.30.0",
        "twig/markdown-extra": "^3.29",
        "twig/twig": "^3.30.0"
    },
    "require-dev": {
        "ext-dom": "*",
        "ext-sodium": "*",
        "ext-tokenizer": "*",
        "ext-xmlwriter": "*",
        "ext-zip": "*",
        "composer/pcre": "^3.4.0",
        "dbrekelmans/bdi": "^1.4.0",
        "ergebnis/composer-normalize": "^2.54.0",
        "friendsofphp/php-cs-fixer": "^3.95.0",
        "helgesverre/toon": "^3.2.1",
        "php-webdriver/webdriver": "^1.16.0",
        "phpstan/phpstan": "^2.3.1",
        "phpstan/phpstan-doctrine": "^2.0.28",
        "phpstan/phpstan-phpunit": "^2.1.1",
        "phpstan/phpstan-symfony": "^2.1.0",
        "phpunit/phpunit": "^13.4.3",
        "playwright-php/playwright": "^1.5",
        "rector/rector": "^2.7.0",
        "roave/security-advisories": "dev-latest",
        "shipmonk/composer-dependency-analyser": "^1.8.4",
        "spaze/phpstan-disallowed-calls": "^4.15.0",
        "symfony/ai-mate": "^0.14.0",
        "symfony/ai-monolog-mate-extension": "^0.14.0",
        "symfony/ai-symfony-mate-extension": "^0.14.0",
        "symfony/browser-kit": "^8.1.9",
        "symfony/css-selector": "^8.1.6",
        "symfony/debug-bundle": "^8.1.0",
        "symfony/dom-crawler": "^8.1.5",
        "symfony/finder": "^8.1.0",
        "symfony/maker-bundle": "^1.68",
        "symfony/panther": "^2.4.0",
        "symfony/process": "^8.1.0",
        "symfony/web-profiler-bundle": "^8.1.9",
        "tacticmedia/qa-bundle": "^2.0.0",
        "tomasvotruba/cognitive-complexity": "^1.3",
        "vincentlanglet/twig-cs-fixer": "^4.1.1",
        "zenstruck/foundry": "^2.14.0"
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "exclude-from-classmap": [
            "vendor/damienharper/auditor/src/Provider/Doctrine"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "vendor/damienharper/auditor/src/Provider/Doctrine"
        ]
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "php-http/discovery": true,
            "symfony/ai-mate-composer-plugin": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "optimize-autoloader": true,
        "process-timeout": 0,
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "docker": true,
            "require": "8.1.*"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts",
            "@dev-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts",
            "@dev-scripts"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "cs": [
            "@pcs",
            "@tcs"
        ],
        "cs:check": [
            "@pcs:check",
            "@tcs:check"
        ],
        "dependencies": "@php vendor/bin/composer-dependency-analyser",
        "dev-scripts": [
            "([ $COMPOSER_DEV_MODE -eq 0 ] || composer normalize)"
        ],
        "lint": [
            "@composer validate --strict",
            "@composer normalize --dry-run --diff",
            "@php bin/console lint:container",
            "@php bin/console lint:twig templates/",
            "@php bin/console lint:yaml config/ --parse-tags",
            "@php bin/console lint:translations",
            "@php bin/console debug:translation en --only-missing",
            "@php bin/console app:security:check-access"
        ],
        "pcs": "@php vendor/bin/php-cs-fixer fix",
        "pcs:check": "@php vendor/bin/php-cs-fixer check --diff",
        "qa": [
            "@rector",
            "@cs",
            "@lint",
            "@dependencies",
            "@stan",
            "@test"
        ],
        "qa:check": [
            "@rector:check",
            "@cs:check",
            "@lint",
            "@dependencies",
            "@stan",
            "@test"
        ],
        "rector": [
            "@php bin/console cache:warmup",
            "@php vendor/bin/rector"
        ],
        "rector:check": [
            "@php bin/console cache:warmup",
            "@php vendor/bin/rector --dry-run"
        ],
        "stan": "bin/phpstan",
        "tcs": "@php vendor/bin/twig-cs-fixer fix",
        "tcs:check": "@php vendor/bin/twig-cs-fixer lint",
        "test": "phpunit --exclude-group e2e",
        "test:e2e": [
            "@test:panther",
            "@test:playwright"
        ],
        "test:panther": "phpunit --group panther",
        "test:playwright": [
            "@php vendor/bin/playwright-install chromium",
            "phpunit --group playwright --fail-on-skipped"
        ]
    }
}
