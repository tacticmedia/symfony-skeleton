parameters:
    level: 8
    doctrine:
        objectManagerLoader: phpstan/object-manager.php
    symfony:
        consoleApplicationLoader: phpstan/console-application.php
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    tmpDir: var/phpstan/src
    bootstrapFiles:
        - vendor/autoload.php
    # tests/ is analysed by phpstan.tests.dist.neon with the test container.
    paths:
        - bin/
        - config/
        - public/
        - src/
    excludePaths:
        - config/reference.php
    ignoreErrors:
        -
            message: '#database can contain string but property expects lowercase-string&non-empty-string#'
            paths:
                - src/Entity/User.php
        # Resets a flag Symfony leaves set across worker requests; no public API does it.
        -
            identifiers:
                - classConstant.internalClass
                - parameter.internalClass
                - property.internalClass
            path: src/Security/ProfilerCspResetter.php

    cognitive_complexity:
        class: 30
        function: 6

    disallowedMethodCalls:
        -
            method: 'Symfony\Bundle\FrameworkBundle\Controller\AbstractController::addFlash()'
            message: 'pass a TranslatableMessage, never a bare key'
            allowParamsAnywhere:
                -
                    position: 2
                    name: 'message'
                    typeString: 'Symfony\Contracts\Translation\TranslatableInterface'

includes:
    - vendor/composer/pcre/extension.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-doctrine/rules.neon
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-symfony/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
    - vendor/spaze/phpstan-disallowed-calls/extension.neon
    - vendor/tomasvotruba/cognitive-complexity/config/extension.neon
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
