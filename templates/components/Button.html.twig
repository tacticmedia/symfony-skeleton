{#
    `kind` picks the style, `size` the scale (md, lg), `full` makes it full width and `icon`
    renders a glyph before the label. Renders <a> when `href` is given, else <button>.
#}
{% props
    kind = 'primary',
    size = 'md',
    type = 'button',
    href = null,
    icon = null,
    full = false,
%}

{%- set button = html_cva(
    base: 'inline-flex items-center justify-center gap-x-2 rounded-md font-semibold shadow-xs focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-50',
    variants: {
        size: {
            md: 'px-3 py-2 text-sm',
            lg: 'px-6 py-3 text-base',
        },
        kind: {
            primary: 'bg-brand-yellow-600 text-brand-yellow-50 hover:bg-brand-yellow-500 hover:text-white focus-visible:outline-brand-yellow-600 dark:bg-brand-yellow-500 dark:hover:bg-brand-yellow-400 dark:text-brand-yellow-950 dark:hover:text-brand-yellow-900 dark:shadow-none dark:focus-visible:outline-brand-yellow-500 cursor-pointer',
            secondary: 'bg-white text-gray-900 inset-ring inset-ring-gray-300 hover:bg-gray-50 focus-visible:outline-gray-400 dark:bg-white/10 dark:text-slate-300 dark:shadow-none dark:inset-ring-white/5 dark:hover:bg-white/20 dark:focus-visible:outline-white/20 cursor-pointer',
            danger: 'bg-brand-red-600 text-white hover:bg-brand-red-500 focus-visible:outline-brand-red-600 dark:bg-brand-red-500 dark:shadow-none dark:hover:bg-brand-red-400 dark:focus-visible:outline-brand-red-500 cursor-pointer',
            ghost: 'bg-transparent text-gray-900 shadow-none hover:bg-gray-100 focus-visible:outline-gray-400 dark:text-slate-300 dark:hover:bg-white/10 cursor-pointer',
            'danger-ghost': 'bg-transparent text-brand-red-600 shadow-none hover:bg-brand-red-50 focus-visible:outline-brand-red-600 dark:text-brand-red-400 dark:hover:bg-brand-red-500/10 cursor-pointer',
            contrast: 'bg-zinc-950 text-white hover:bg-zinc-800 focus-visible:outline-zinc-950 cursor-pointer',
        },
    },
) -%}

{%- set classes = button.apply({size, kind}, full ? 'w-full') -%}

{%- set slot -%}
    {%- if icon -%}<twig:ux:icon name="{{ icon }}" aria-hidden="true" class="size-5" />{%- endif -%}
    {%- block content %}{% endblock -%}
{%- endset -%}

{% if href is not null %}
    <a href="{{ href }}"{{ attributes.defaults({class: classes}) }}>{{ slot }}</a>
{% else %}
    <button type="{{ type }}"{{ attributes.defaults({class: classes}) }}>{{ slot }}</button>
{% endif %}
