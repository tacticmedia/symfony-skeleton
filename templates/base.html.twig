<!DOCTYPE html>
<html lang="{{ app.locale|replace({'_': '-'}) }}" class="bg-gray-200 dark:bg-neutral-800 text-gray-800 dark:text-gray-100">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Welcome!{% endblock %}</title>

        <meta name="turbo-cache-control" content="no-cache">
        <meta name="view-transition" content="same-origin">

        {%- set _nonce = null -%}
        {%- guard function csp_nonce -%}
            {#- see https://github.com/nelmio/NelmioSecurityBundle/issues/321 -#}
            {%- set _nonce = csp_nonce('script') -%}
            {%- set _nonce = csp_nonce('style') -%}
            <meta name="csp-nonce" content="{{ _nonce }}">
        {%- endguard -%}

        {%- if _nonce is not empty -%}
            {% set _nonce_attributes = {nonce: _nonce} %}
        {%- else -%}
            {% set _nonce_attributes = {} %}
        {%- endif -%}

        {#- see https://stackoverflow.com/questions/21147149/flash-of-unstyled-content-fouc-in-firefox-only-is-ff-slow-renderer -#}
        <script{%- guard function csp_nonce %} nonce="{{ _nonce }}"{% endguard -%}>let FF_FOUC_FIX;</script>{#--#}

        {%- block stylesheets %}{% endblock -%}

        {%- block javascripts -%}
            {% block importmap %}{{ importmap('app', _nonce_attributes) }}{% endblock %}
        {%- endblock -%}
    </head>

    {%- set attr = (attr ?? {})|merge({
        'data-turbo': app.request.hasSession(false) and app.session.started and app.session.has('turbo-disabled') ? 'false' : 'true',
        'data-turbo-prefetch': 'false',
        'data-test-id': 'screen-' ~ app.current_route,
        'data-release': app_release ?? null,
        'data-sentry-environment': sentry_environment ?? null,
        'data-sentry-dsn': sentry_dsn ?? null,
        'data-user-id': app.user.id ?? null,
        'data-user-email': app.user.email ?? null,
        'data-user-name': app.user ?? null,
        'data-fullstory-id': fullstory_id ?? null,
    }) -%}

    <body {{ html_attr(attr) }}>
        {%- block body %}{% endblock -%}

        <turbo-frame id="flash_messages">
            {%- if app.request.hasSession(false) and app.session.started -%}
                {%- include '_partials/flash-messages.html.twig' -%}
            {%- endif -%}
        </turbo-frame>

        <div id="global_event"></div>{#--#}
    </body>

    {%- if fullstory_id ?? null -%}
        {{- importmap('fullstory') -}}
    {%- endif -%}

    {%- if sentry_dsn ?? null -%}
        {{- importmap('sentry') -}}
    {%- endif -%}
</html>
