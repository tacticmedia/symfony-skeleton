parameters:
    level: 8
    doctrine:
        objectManagerLoader: phpstan/object-manager.php
    symfony:
        consoleApplicationLoader: phpstan/console-application.php
        containerXmlPath: var/cache/test/App_KernelTestDebugContainer.xml
    tmpDir: var/phpstan/tests
    bootstrapFiles:
        - vendor/autoload.php
    paths:
        - tests
    ignoreErrors:
        # Drives the profiler CSP handler that App\Security\ProfilerCspResetter resets; no public API does it.
        -
            identifier: method.internalClass
            path: tests/Functional/Security/ProfilerCspResetterTest.php

    cognitive_complexity:
        class: 30
        function: 6

    disallowedMethodCalls:
        -
            method:
                - 'Symfony\Component\DomCrawler\Crawler::selectButton()'
                - 'Symfony\Component\DomCrawler\Crawler::selectLink()'
                - 'Symfony\Component\DomCrawler\Crawler::selectImage()'
                - 'Symfony\Component\DomCrawler\Crawler::filterXPath()'
                - 'Symfony\Component\Panther\DomCrawler\Crawler::selectButton()'
                - 'Symfony\Component\Panther\DomCrawler\Crawler::selectLink()'
                - 'Symfony\Component\Panther\DomCrawler\Crawler::selectImage()'
                - 'Symfony\Component\Panther\DomCrawler\Crawler::filterXPath()'
                - 'Symfony\Component\BrowserKit\AbstractBrowser::clickLink()'
                - 'Symfony\Component\BrowserKit\AbstractBrowser::submitForm()'
            message: 'locate the element by its data-test-id, see docs/test-ids.md'

    disallowedStaticCalls:
        -
            method:
                - 'Facebook\WebDriver\WebDriverBy::linkText()'
                - 'Facebook\WebDriver\WebDriverBy::partialLinkText()'
                - 'Facebook\WebDriver\WebDriverBy::xpath()'
            message: 'locate the element by its data-test-id, see docs/test-ids.md'

includes:
    - vendor/composer/pcre/extension.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-doctrine/rules.neon
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-symfony/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
    - vendor/spaze/phpstan-disallowed-calls/extension.neon
    - vendor/tomasvotruba/cognitive-complexity/config/extension.neon
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
